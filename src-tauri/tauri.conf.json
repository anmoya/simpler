{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simpler",
  "version": "0.1.4",
  "identifier": "app.simpler.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1427",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Simpler",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhENEZEQjgzOEQwRDZBQ0IKUldUTGFnMk5nOXRQalNaOXovaGJtRGU0elY0TURjSmFmZXpjRUg5ck5ncnEyU0xPYUxUeUNtT1gK",
      "endpoints": [
        "https://github.com/anmoya/simpler/releases/latest/download/latest.json"
      ]
    }
  }
}
